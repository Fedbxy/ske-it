<div class="global-nav">
  <a href="/" class="btn-manga" style="text-decoration: none;">🏠 HOME</a>
  <% if (typeof user !== 'undefined' && user) { %>
    <a href="/dashboard" class="btn-manga" style="text-decoration: none;">👤 DASHBOARD</a>
  <% } else { %>
    <a href="/login" class="btn-manga" style="text-decoration: none;">👤 LOGIN</a>
  <% } %>
  <a href="/leaderboard" class="btn-manga" style="text-decoration: none;">🏆 LEADERBOARD</a>
  <a href="/matches" class="btn-manga" style="text-decoration: none; border-color: #555;">📜 MATCH LOG</a>
  <% if (typeof user !== 'undefined' && user) { %>
    <button class="btn-manga" onclick="logout()" style="background: #ffcccc;">🚪 LOGOUT</button>
  <% } %>
</div>

<style>
  .global-nav {
    margin-top: 30px;
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    width: 100%;
  }
</style>

<script>
  if (typeof window.logout !== 'function') {
    window.logout = async function() {
      if (!confirm('Are you sure you want to logout?')) return;
      if (typeof Auth !== 'undefined') {
        await Auth.signOut();
        return;
      }
      try {
        await fetch('/auth/logout', { method: 'POST' });
        sessionStorage.removeItem('skeit_user');
      } catch (err) {}
      window.location.href = '/login';
    }
  }
</script>
