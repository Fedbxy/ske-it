<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>404 - Page Not Found</title>
  <link rel="stylesheet" href="/styles.css" />
  <style>
    .error-container {
      min-height: 100vh;
      background: var(--paper);
      color: var(--ink);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .error-card {
      max-width: 500px;
      background: var(--paper2);
      border: 5px solid var(--ink);
      box-shadow: 8px 8px 0 var(--ink);
      padding: 40px;
      text-align: center;
    }

    .error-code {
      font-family: var(--font-display);
      font-size: clamp(3rem, 10vw, 6rem);
      font-weight: bold;
      color: var(--ink);
      margin: 0;
      line-height: 1;
      text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.2);
    }

    .error-title {
      font-family: var(--font-display);
      font-size: 1.8rem;
      letter-spacing: 2px;
      margin: 16px 0 12px 0;
    }

    .error-message {
      font-family: var(--font-hand);
      font-size: 1rem;
      line-height: 1.6;
      margin: 20px 0;
      opacity: 0.8;
    }

    .error-emoji {
      font-size: 4rem;
      margin: 20px 0;
      display: block;
    }

    .error-buttons {
      display: flex;
      gap: 12px;
      justify-content: center;
      margin-top: 30px;
      flex-wrap: wrap;
    }

    .btn-manga {
      padding: 12px 24px;
      border: 3px solid var(--ink);
      background: var(--paper);
      color: var(--ink);
      font-family: var(--font-display);
      font-size: 0.95rem;
      letter-spacing: 1px;
      cursor: pointer;
      box-shadow: 4px 4px 0 var(--ink);
      transition: all 0.2s;
      text-decoration: none;
      display: inline-block;
    }

    .btn-manga:hover {
      background: var(--paper2);
    }

    .btn-manga:active {
      box-shadow: 0 0 0 var(--ink);
      transform: translate(4px, 4px);
    }

    .theme-toggle {
      position: fixed;
      top: 20px;
      right: 20px;
      border: 2px solid var(--ink);
      background: var(--paper2);
      padding: 8px 12px;
      cursor: pointer;
      font-size: 1.2rem;
      z-index: 50;
    }
  </style>
</head>
<body class="halftone-bg" style="margin: 0;">
  <button class="theme-toggle" data-icon="🌙" title="Toggle Theme"></button>

  <div class="error-container">
    <div class="error-card">
      <span class="error-emoji">🎨❌</span>
      <h1 class="error-code">404</h1>
      <h2 class="error-title">Page Not Found!</h2>
      <p class="error-message">
        Looks like you tried to draw a page that doesn't exist in our sketchbook.<br/>
        <br/>
        <small>The page you're looking for has been erased from the canvas.</small>
      </p>

      <div class="error-buttons">
        <a href="/" class="btn-manga">🏠 HOME</a>
        <a href="/game" class="btn-manga">🎮 PLAY</a>
        <a href="/leaderboard" class="btn-manga">🏆 SCORES</a>
      </div>
    </div>
  </div>

  <script>
    document.querySelector('.theme-toggle').addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('skeit_theme', next);
      const btn = document.querySelector('.theme-toggle');
      btn.setAttribute('data-icon', next === 'dark' ? '☀️' : '🌙');
    });

    // Initialize theme
    const saved = localStorage.getItem('skeit_theme') || 'light';
    document.documentElement.setAttribute('data-theme', saved);
    document.querySelector('.theme-toggle').setAttribute('data-icon', saved === 'dark' ? '☀️' : '🌙');
  </script>
</body>
</html>
