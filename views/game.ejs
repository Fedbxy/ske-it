<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SKE-IT — Game</title>
  <link rel="stylesheet" href="/styles.css" />
  <style>
    .timer-critical {
      animation: pulse 0.5s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.6; }
    }

    /* Drawing surface logic */
    #drawing-canvas {
      display: block;
      width: 100%;
      height: 100%;
      cursor: inherit;
      touch-action: none;
    }

    .effect-panel {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.85);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 20px;
      cursor: pointer;
    }
  </style>
</head>
<body class="halftone-bg" style="margin: 0; padding: 0;">
  <div class="game-container">
    <!-- Header -->
    <div class="game-header">
      <div class="title-display" style="font-size: 1.8rem;">SKE-IT</div>
      
      <div class="game-stats">
        <div class="stat">
          <div class="stat-label">ROUND</div>
          <div class="stat-value" id="round-display">1/5</div>
        </div>
        <div class="stat">
          <div class="stat-label">TIME</div>
          <div class="stat-value" id="timer-display">02:00</div>
        </div>
        <div class="stat">
          <div class="stat-label">SCORE</div>
          <div class="stat-value" id="score-display">0</div>
        </div>
      </div>

      <div style="display: flex; gap: 10px; align-items: center;">
        <%- include('partials/theme-btn') %>
      </div>
    </div>

    <!-- Main Content -->
    <div class="game-content">
      <!-- Canvas Section -->
      <div class="canvas-section">
        <div class="word-display" id="current-word">Draw: SOMETHING!</div>
        <div class="canvas-wrapper">
          <canvas id="drawing-canvas"></canvas>
        </div>
        <div class="hint-text" id="hint-text"></div>
        <div class="toolbar">
          <button id="draw-btn" class="btn-tool active-tool" onclick="setEraseMode(false)">✏️ DRAW</button>
          <button id="erase-btn" class="btn-tool" onclick="setEraseMode(true)">🧹 ERASE</button>
          <button id="clear-btn" class="btn-tool" onclick="clearCanvas()">🗑️ CLEAR</button>
          <button id="skip-btn" class="btn-tool">⏩ SKIP</button>
          <div style="flex: 1;"></div>
          <div class="brush-sizes">
            <button class="btn-tool brush-btn" data-size="2" onclick="setBrushSize(2)">●</button>
            <button class="btn-tool brush-btn" data-size="4" onclick="setBrushSize(4)">●●</button>
            <button class="btn-tool brush-btn" data-size="8" onclick="setBrushSize(8)">●●●</button>
            <button class="btn-tool brush-btn" data-size="12" onclick="setBrushSize(12)">●●●●</button>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="sidebar">
        <div class="sidebar-panel">
          <div class="sidebar-title">ACTIONS</div>
          <button id="submit-btn" class="sidebar-btn btn-success" disabled style="font-weight: bold; font-size: 1.2rem;">✓ SUBMIT!</button>
        </div>

        <div class="sidebar-panel">
          <div class="sidebar-title">TIPS</div>
          <div style="font-size: 0.85rem; line-height: 1.4; opacity: 0.9;">
            • Draw clear shapes<br/>
            • Use all the space<br/>
            • Add details<br/>
            • Be confident!
          </div>
        </div>

        <div class="sidebar-panel">
          <div class="sidebar-title">NAVIGATION</div>
          <div class="nav-grid">
            <a href="/" class="sidebar-btn">🏠 Home</a>
            <a href="/leaderboard" class="sidebar-btn">🏆 Leader</a>
            <a href="/matches" class="sidebar-btn">📜 Log</a>
          </div>
        </div>

        <button id="logout-btn" class="sidebar-btn logout" onclick="logout()">🚪 LOGOUT</button>
      </div>
    </div>
  </div>

  <script src="/javascripts/auth.js"></script>
  <script src="/javascripts/game.js"></script>
  <script>
    async function logout() {
      if (!confirm('Are you sure you want to logout?')) return;
      if (typeof Auth !== 'undefined') {
        await Auth.signOut();
        return;
      }
      window.location.href = '/login';
    }
  </script>
</body>
</html>
