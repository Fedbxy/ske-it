<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SKE-IT — Player Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/styles.css" />
  <style>
    .dashboard-container {
      min-height: 100vh;
      background: var(--paper);
      color: var(--ink);
      padding: 20px;
    }

    .dashboard-header {
      text-align: center;
      margin-bottom: 40px;
    }

    .dashboard-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 5vw, 3.5rem);
      letter-spacing: 3px;
      margin-bottom: 10px;
      text-shadow: 3px 3px 0 var(--ink);
    }

    .dashboard-subtitle {
      font-family: var(--font-hand);
      font-size: 1.2rem;
      opacity: 0.8;
    }

    .grid-container {
      max-width: 900px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    @media (max-width: 768px) {
      .grid-container {
        grid-template-columns: 1fr;
      }
    }

    .panel {
      background: var(--paper2);
      border: 3px solid var(--ink);
      box-shadow: 6px 6px 0 var(--ink);
      padding: 24px;
    }

    .panel-title {
      font-family: var(--font-display);
      font-size: 1.5rem;
      border-bottom: 2px solid var(--ink);
      padding-bottom: 8px;
      margin-bottom: 16px;
    }

    .stat-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 0;
      border-bottom: 2px dashed var(--ink);
      font-family: var(--font-hand);
      font-size: 1.1rem;
    }

    .stat-row:last-child {
      border-bottom: none;
    }

    .stat-value {
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-weight: bold;
    }

    .btn-manga {
      padding: 12px 20px;
      border: 3px solid var(--ink);
      background: var(--paper);
      color: var(--ink);
      font-family: var(--font-display);
      font-size: 1rem;
      letter-spacing: 1px;
      cursor: pointer;
      box-shadow: 4px 4px 0 var(--ink);
      transition: all 0.2s;
      text-decoration: none;
      display: inline-block;
      text-align: center;
    }

    .btn-manga:hover {
      background: var(--paper2);
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 var(--ink);
    }

    .btn-manga:active {
      box-shadow: 0 0 0 var(--ink);
      transform: translate(4px, 4px);
    }

    .manga-input {
      width: 100%;
      padding: 12px;
      border: 3px solid var(--ink);
      background: var(--paper);
      font-family: var(--font-hand);
      font-size: 1rem;
      margin-bottom: 12px;
    }

    .manga-input:focus {
      outline: none;
      box-shadow: 2px 2px 0 var(--ink);
    }

    .theme-toggle {
      position: fixed;
      top: 20px;
      right: 20px;
      border: 2px solid var(--ink);
      background: var(--paper2);
      padding: 8px 12px;
      cursor: pointer;
      font-size: 1.2rem;
      z-index: 50;
    }

    .controls {
      display: flex;
      gap: 12px;
      justify-content: center;
      margin-top: 40px;
      flex-wrap: wrap;
    }
  </style>
</head>
<body class="halftone-bg" style="margin: 0;">
  <button class="theme-toggle" data-icon="🌙" title="Toggle Theme"></button>

  <div class="dashboard-container">
    <div class="dashboard-header">
      <div class="dashboard-title">PLAYER HQ</div>
      <div class="dashboard-subtitle">Welcome back, <strong><%= user.username %></strong>!</div>
    </div>

    <div class="grid-container">
      
      <!-- Actions Panel -->
      <div class="panel" style="display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 20px;">
        <div style="font-family: var(--font-hand); font-size: 1.3rem; text-align: center;">Ready to sketch?</div>
        <a href="/game" class="btn-manga" style="font-size: 1.8rem; padding: 20px 40px; background: #ccffcc;">🔥 PLAY NOW!</a>
      </div>

      <!-- Stats Panel -->
      <div class="panel">
        <div class="panel-title">YOUR STATS</div>
        <div class="stat-row">
          <span>🏆 Best Match Score</span>
          <span class="stat-value" style="color: #cc0000;"><%= user.highScore || 0 %></span>
        </div>
        <div class="stat-row">
          <span>📈 Career Total Points</span>
          <span class="stat-value"><%= user.score || 0 %></span>
        </div>
        <div class="stat-row">
          <span>🎮 Matches Played</span>
          <span class="stat-value"><%= user.gamesPlayed || 0 %></span>
        </div>
      </div>

      <!-- Profile Settings Panel -->
      <div class="panel" style="grid-column: 1 / -1; max-width: 500px; margin: 0 auto; width: 100%;">
        <div class="panel-title">ACCOUNT SETTINGS</div>
        <div style="font-family: var(--font-hand); margin-bottom: 12px;">Change Password:</div>
        
        <div id="settings-error" style="display:none; color: red; font-family: var(--font-hand); margin-bottom: 10px;"></div>
        <div id="settings-success" style="display:none; color: green; font-family: var(--font-hand); margin-bottom: 10px;"></div>

        <input type="password" id="new-password" class="manga-input" placeholder="New Password (min 6 chars)" />
        <input type="password" id="confirm-password" class="manga-input" placeholder="Confirm New Password" />
        <button class="btn-manga" style="width: 100%; font-size: 1.1rem;" onclick="changePassword()">UPDATE PASSWORD</button>
      </div>

    </div>

    <!-- Navigation -->
    <%- include('partials/nav') %>
  </div>

  <script src="/javascripts/auth.js"></script>
  <script>
    async function changePassword() {
      const newPassword = document.getElementById('new-password').value;
      const confirmPassword = document.getElementById('confirm-password').value;
      const errEl = document.getElementById('settings-error');
      const succEl = document.getElementById('settings-success');
      
      errEl.style.display = 'none';
      succEl.style.display = 'none';

      if (!newPassword || newPassword.length < 6) {
        errEl.textContent = 'Password must be at least 6 characters.';
        errEl.style.display = 'block';
        return;
      }
      
      if (newPassword !== confirmPassword) {
        errEl.textContent = 'Passwords do not match.';
        errEl.style.display = 'block';
        return;
      }

      try {
        const response = await fetch('/auth/update-password', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ newPassword })
        });
        
        const data = await response.json();
        
        if (!response.ok) {
          throw new Error(data.message || 'Failed to update password');
        }
        
        document.getElementById('new-password').value = '';
        succEl.textContent = '✅ Password updated successfully!';
        succEl.style.display = 'block';
      } catch (err) {
        errEl.textContent = '❌ ' + err.message;
        errEl.style.display = 'block';
      }
    }

    async function logout() {
      if (!confirm('Are you sure you want to logout?')) return;
      if (typeof Auth !== 'undefined') {
        await Auth.signOut();
        return;
      }
      window.location.href = '/login';
    }

    // Theme toggle
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelector('.theme-toggle').addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        const next = current === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('skeit_theme', next);
        const btn = document.querySelector('.theme-toggle');
        btn.setAttribute('data-icon', next === 'dark' ? '☀️' : '🌙');
      });

      const saved = localStorage.getItem('skeit_theme') || 'light';
      document.documentElement.setAttribute('data-theme', saved);
      const btn = document.querySelector('.theme-toggle');
      btn.setAttribute('data-icon', saved === 'dark' ? '☀️' : '🌙');
    });
  </script>
</body>
</html>