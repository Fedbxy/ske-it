<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SKE-IT — Leaderboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/styles.css" />
  <style>
    .leaderboard-container {
      min-height: 100vh;
      background: var(--paper);
      color: var(--ink);
      padding: 20px;
    }

    .leaderboard-header {
      text-align: center;
      margin-bottom: 40px;
    }

    .leaderboard-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 5vw, 3.5rem);
      letter-spacing: 3px;
      margin-bottom: 10px;
      text-shadow: 3px 3px 0 var(--ink);
    }

    .leaderboard-subtitle {
      font-family: var(--font-hand);
      font-size: 1.1rem;
      opacity: 0.7;
    }

    .leaderboard-card {
      max-width: 600px;
      margin: 0 auto;
      background: var(--paper2);
      border: 3px solid var(--ink);
      box-shadow: 6px 6px 0 var(--ink);
      padding: 0;
    }

    .leaderboard-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .leaderboard-item {
      padding: 16px 20px;
      border-bottom: 2px solid var(--ink);
      display: flex;
      align-items: center;
      gap: 16px;
      font-family: var(--font-hand);
    }

    .leaderboard-item:last-child {
      border-bottom: none;
    }

    .leaderboard-rank {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: bold;
      min-width: 50px;
      text-align: center;
    }

    .leaderboard-rank.rank-1 {
      color: #ffd700;
      text-shadow: 2px 2px 0 #000;
    }

    .leaderboard-rank.rank-2 {
      color: #c0c0c0;
      text-shadow: 1px 1px 0 #000;
    }

    .leaderboard-rank.rank-3 {
      color: #cd7f32;
      text-shadow: 1px 1px 0 #000;
    }

    .leaderboard-info {
      flex: 1;
    }

    .leaderboard-name {
      font-weight: bold;
      font-size: 1rem;
      margin-bottom: 4px;
    }

    .leaderboard-stats {
      font-size: 0.85rem;
      opacity: 0.7;
    }

    .leaderboard-score {
      text-align: right;
      font-family: var(--font-display);
      font-size: 1.3rem;
      font-weight: bold;
      min-width: 100px;
    }

    .leaderboard-empty {
      padding: 40px 20px;
      text-align: center;
      font-family: var(--font-hand);
    }

    .controls {
      display: flex;
      gap: 12px;
      justify-content: center;
      margin-top: 30px;
      flex-wrap: wrap;
    }

    .btn-manga {
      padding: 12px 20px;
      border: 3px solid var(--ink);
      background: var(--paper);
      color: var(--ink);
      font-family: var(--font-display);
      font-size: 1rem;
      letter-spacing: 1px;
      cursor: pointer;
      box-shadow: 4px 4px 0 var(--ink);
      transition: all 0.2s;
    }

    .btn-manga:hover {
      background: var(--paper2);
    }

    .btn-manga:active {
      box-shadow: 0 0 0 var(--ink);
      transform: translate(4px, 4px);
    }

    .theme-toggle {
      position: fixed;
      top: 20px;
      right: 20px;
      border: 2px solid var(--ink);
      background: var(--paper2);
      padding: 8px 12px;
      cursor: pointer;
      font-size: 1.2rem;
      z-index: 50;
    }

    .loading {
      text-align: center;
      padding: 40px;
      font-family: var(--font-hand);
    }

    @media (max-width: 768px) {
      .leaderboard-title {
        font-size: 1.8rem;
      }
      .leaderboard-item {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
      }
      .leaderboard-score {
        text-align: left;
      }
    }
  </style>
</head>
<body class="halftone-bg" style="margin: 0;">
  <button class="theme-toggle" data-icon="🌙" title="Toggle Theme"></button>

  <div class="leaderboard-container">
    <div class="leaderboard-header">
      <div class="leaderboard-title">🏆 LEADERBOARD</div>
      <div class="leaderboard-subtitle">Top Players - Sketch & Score!</div>
    </div>

    <div class="leaderboard-card">
      <div id="loading" class="loading">
        Loading leaderboard...
      </div>
      <ol id="leaderboardList" class="leaderboard-list" style="display: none;">
      </ol>
    </div>

    <div class="controls">
      <a href="/game" class="btn-manga">← PLAY GAME</a>
      <button class="btn-manga" onclick="location.reload()">🔄 REFRESH</button>
      <button class="btn-manga" onclick="logout()">🚪 LOGOUT</button>
    </div>
  </div>

  <script src="/javascripts/auth.js"></script>
  <script>
    const leaderboardList = document.getElementById('leaderboardList');
    const loadingDiv = document.getElementById('loading');

    async function loadLeaderboard() {
      try {
        const response = await fetch('/api/leaderboard?limit=20');
        if (!response.ok) throw new Error('Failed to load');

        const data = await response.json();
        loadingDiv.style.display = 'none';

        if (!data.leaderboard || data.leaderboard.length === 0) {
          leaderboardList.style.display = 'none';
          loadingDiv.style.display = 'block';
          loadingDiv.textContent = 'No scores yet. Be the first!';
          return;
        }

        leaderboardList.innerHTML = data.leaderboard.map((entry, index) => {
          const rank = index + 1;
          let rankClass = 'leaderboard-rank';
          if (rank === 1) rankClass += ' rank-1';
          else if (rank === 2) rankClass += ' rank-2';
          else if (rank === 3) rankClass += ' rank-3';

          return `
            <li class="leaderboard-item">
              <div class="${rankClass}">#${rank}</div>
              <div class="leaderboard-info">
                <div class="leaderboard-name">${entry.username || 'Anonymous'}</div>
                <div class="leaderboard-stats">📊 Played ${entry.gamesPlayed || 0} matches · Total score: ${entry.score || 0}</div>
              </div>
              <div class="leaderboard-score">${entry.highScore || 0}</div>
            </li>
          `;
        }).join('');

        leaderboardList.style.display = 'block';
      } catch (err) {
        console.error('Leaderboard error:', err);
        loadingDiv.textContent = 'Failed to load leaderboard';
      }
    }

    // Load leaderboard on page load
    document.addEventListener('DOMContentLoaded', () => {
      loadLeaderboard();

      // Theme toggle
      document.querySelector('.theme-toggle').addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        const next = current === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('skeit_theme', next);
        const btn = document.querySelector('.theme-toggle');
        btn.setAttribute('data-icon', next === 'dark' ? '☀️' : '🌙');
      });

      // Initialize theme
      const saved = localStorage.getItem('skeit_theme') || 'light';
      document.documentElement.setAttribute('data-theme', saved);
      const btn = document.querySelector('.theme-toggle');
      btn.setAttribute('data-icon', saved === 'dark' ? '☀️' : '🌙');
    });

    async function logout() {
      if (!confirm('Are you sure you want to logout?')) return;
      if (typeof Auth !== 'undefined') {
        await Auth.signOut();
        return;
      }
      window.location.href = '/login';
    }
  </script>
</body>
</html>
